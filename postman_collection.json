{
  "info": {
    "name": "Resource Booking System API",
    "description": "Clean collection for registration, JWT login, resource management, reservations, and Actuator monitoring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminJwt", "value": "" },
    { "key": "userJwt", "value": "" },
    { "key": "resourceId", "value": "1" },
    { "key": "reservationId", "value": "1" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register USER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"postman-user-{{$timestamp}}\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login ADMIN",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('JWT returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
            "pm.collectionVariables.set('adminJwt', body.token.trim());"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login USER",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('JWT returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
            "pm.collectionVariables.set('userJwt', body.token.trim());"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create USER (ADMIN)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"managed-user-{{$timestamp}}\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create ADMIN (ADMIN)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"managed-admin-{{$timestamp}}\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create ADMIN as USER (expect 403)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"forbidden-admin-{{$timestamp}}\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List Resources (USER)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/resources?page=0&size=10&sort=id,asc" }
        },
        {
          "name": "Get Resource (USER)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/resources/{{resourceId}}" }
        },
        {
          "name": "Create Resource (ADMIN)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Room\",\n  \"type\": \"ROOM\",\n  \"description\": \"Created from Postman\",\n  \"location\": \"Floor 2\",\n  \"capacity\": 6,\n  \"pricePerHour\": 10.00,\n  \"available\": true\n}" },
            "url": "{{baseUrl}}/api/resources"
          }
        },
        {
          "name": "Update Resource (ADMIN)",
          "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Postman Room\",\n  \"type\": \"ROOM\",\n  \"pricePerHour\": 12.00,\n  \"available\": true\n}" }, "url": "{{baseUrl}}/api/resources/{{resourceId}}" }
        },
        {
          "name": "Delete Resource (ADMIN)",
          "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/resources/{{resourceId}}" }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation (USER)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "if (body.id) pm.collectionVariables.set('reservationId', body.id);"] } }],
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"resourceId\": {{resourceId}},\n  \"startTime\": \"2027-01-10T09:00:00\",\n  \"endTime\": \"2027-01-10T11:00:00\"\n}" }, "url": "{{baseUrl}}/api/reservations" }
        },
        {
          "name": "List My Reservations (USER)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/reservations?page=0&size=10&sort=createdAt,desc" }
        },
        {
          "name": "List All Reservations (ADMIN)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/reservations?status=PENDING&minPrice=5&maxPrice=100&page=0&size=10&sort=price,desc" }
        },
        {
          "name": "Create Overlap (expect 400)",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"resourceId\": {{resourceId}},\n  \"startTime\": \"2027-01-10T10:00:00\",\n  \"endTime\": \"2027-01-10T12:00:00\"\n}" }, "url": "{{baseUrl}}/api/reservations" }
        },
        {
          "name": "Get Reservation (USER)",
          "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/reservations/{{reservationId}}" }
        },
        {
          "name": "Cancel Reservation (USER)",
          "request": { "method": "PATCH", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel" }
        },
        {
          "name": "Update Reservation (ADMIN)",
          "request": { "method": "PUT", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"resourceId\": {{resourceId}},\n  \"startTime\": \"2027-01-10T09:00:00\",\n  \"endTime\": \"2027-01-10T12:00:00\",\n  \"status\": \"CONFIRMED\"\n}" }, "url": "{{baseUrl}}/api/reservations/{{reservationId}}" }
        },
        {
          "name": "Delete Reservation (ADMIN)",
          "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] }, "url": "{{baseUrl}}/api/reservations/{{reservationId}}" }
        }
      ]
    },
    {
      "name": "Monitoring",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" } },
        { "name": "Prometheus Metrics", "request": { "method": "GET", "url": "{{baseUrl}}/actuator/prometheus" } }
      ]
    }
  ]
}
