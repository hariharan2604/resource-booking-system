  "item": [
    {
      "name": "00 - Authentication",
      "item": [
        {
          "name": "Register USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman-user-{{$timestamp}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration request completed', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN - Save JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login successful', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('JWT exists', function () {",
                  "    pm.expect(body).to.have.property('token');",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (body.token) {",
                  "    const token = body.token.trim();",
                  "    pm.collectionVariables.set('adminJwt', token);",
                  "    console.log('ADMIN JWT saved successfully');",
                  "    console.log('adminJwt length:', token.length);",
                  "}",
                  "",
                  "console.log('Collection adminJwt:', pm.collectionVariables.get('adminJwt'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login USER - Save JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User login successful', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('JWT exists', function () {",
                  "    pm.expect(body).to.have.property('token');",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (body.token) {",
                  "    const token = body.token.trim();",
                  "    pm.collectionVariables.set('userJwt', token);",
                  "    console.log('USER JWT saved successfully');",
                  "    console.log('userJwt length:', token.length);",
                  "}",
                  "",
                  "console.log('Collection userJwt:', pm.collectionVariables.get('userJwt'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Debug - Show JWT Variables",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('========== JWT DEBUG ==========');",
                  "console.log('adminJwt exists:', !!pm.collectionVariables.get('adminJwt'));",
                  "console.log('adminJwt length:', (pm.collectionVariables.get('adminJwt') || '').length);",
                  "console.log('userJwt exists:', !!pm.collectionVariables.get('userJwt'));",
                  "console.log('userJwt length:', (pm.collectionVariables.get('userJwt') || '').length);",
                  "console.log('================================');"
                ]
              }
            }
          ]
        }
      ]
    },
